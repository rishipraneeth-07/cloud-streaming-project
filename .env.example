# PostgreSQL credentials (use a strong local-only password)
POSTGRES_DB=cloud_pipeline
POSTGRES_USER=cloud_user
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MinIO credentials must match the running MinIO container
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-this-minio-secret
MINIO_SECURE=false

# Kafka host address for Python processes running on Ubuntu
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=orders
