    {
      "id": 12,
      "title": "Migration history",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "project-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT id, source_bucket, source_key, destination_bucket, destination_key, status, started_at, completed_at, error_message FROM migration_history ORDER BY started_at DESC LIMIT 50"
        }
      ]
    },
    {
      "id": 13,
      "title": "File inventory \u2014 latest seen",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "project-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT bucket, object_name, inferred_source, size_bytes, etag, last_modified, current_tier, compression_codec, estimated_monthly_cost_usd, last_seen_at FROM object_inventory ORDER BY last_seen_at DESC LIMIT 100"
        }
      ]
    },
    {
      "id": 14,
      "title": "Pipeline run totals",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "project-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT pipeline_name, run_type, status, COUNT(*) AS runs, SUM(records_processed) AS records_processed, SUM(records_failed) AS records_failed, MAX(started_at) AS last_started FROM pipeline_runs GROUP BY pipeline_name, run_type, status ORDER BY last_started DESC"
        }
      ]
    },
    {
      "id": 15,
      "title": "Optimization history",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "project-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT id, bucket, object_name, operation, source_codec, target_codec, before_bytes, after_bytes, bytes_saved, status, created_at FROM object_optimization_history ORDER BY created_at DESC LIMIT 100"
        }
      ]
    }
  ]
